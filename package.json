{
  "name": "everything-warframe",
  "version": "0.9.72",
  "description": "Everything Warframe — overlay companion for Windows and Linux (Steam/Proton): worldstate, relics, rivens, foundry, inventory",
  "main": "dist-electron/main.cjs",
  "author": "Everything Warframe <hoeslovevid@users.noreply.github.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/hoeslovevid/everything-warframe.git"
  },
  "homepage": "https://hoeslovevid.github.io/Warframe-Companion-Helper/",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:electron",
    "build:riven-prefs": "node scripts/build-riven-preferences.mjs",
    "build:electron": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --external:electron --external:tesseract.js --external:electron-updater --external:@repeato/ocr --external:sharp --external:onnxruntime-node --outdir=dist-electron --format=cjs --out-extension:.js=.cjs",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && npm run build:electron && electron .\"",
    "start": "npm run electron:dev",
    "lfg:serve": "node lfg-api/boot.mjs",
    "dist": "npm run build && electron-builder --win -c.win.signAndEditExecutable=false",
    "dist:dir": "npm run build && electron-builder --win --dir -c.win.signAndEditExecutable=false",
    "dist:linux": "npm run build && electron-builder --linux",
    "release": "npm run build && electron-builder --win --publish always -c.win.signAndEditExecutable=false",
    "release:win": "npm run build && electron-builder --win --publish always -c.win.signAndEditExecutable=false",
    "release:linux": "npm run build && electron-builder --linux --publish always"
  },
  "dependencies": {
    "@repeato/ocr": "^1.5.21",
    "electron-updater": "^6.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.3.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.voidlens.warframe-companion-helper",
    "productName": "Everything Warframe",
    "copyright": "Copyright © Everything Warframe contributors",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "lfg-api",
        "to": "lfg-api",
        "filter": [
          "**/*",
          "!node_modules",
          "!node_modules/**",
          "!data/*.sqlite",
          "!data/*.sqlite-*",
          "!data/*.json",
          "!data/*.tmp"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/tesseract.js/**/*",
      "**/node_modules/tesseract.js-core/**/*",
      "**/node_modules/@repeato/ocr/**/*",
      "**/node_modules/onnxruntime-node/**/*",
      "**/node_modules/sharp/**/*",
      "**/node_modules/@img/**/*"
    ],
    "extraMetadata": {
      "main": "dist-electron/main.cjs"
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "resources/icon-256.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Game",
      "synopsis": "Warframe overlay companion for Windows and Linux (Steam/Proton)",
      "maintainer": "Everything Warframe <hoeslovevid@users.noreply.github.com>",
      "executableName": "everything-warframe",
      "artifactName": "Everything-Warframe-${version}-${os}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Everything Warframe",
      "deleteAppDataOnUninstall": true,
      "artifactName": "${productName}-${version}-Setup-${os}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${os}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hoeslovevid",
        "repo": "everything-warframe",
        "releaseType": "release"
      }
    ]
  }
}
